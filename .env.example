# TalkOnのOpenAI実API設定例です。このファイルに秘密情報を入れず、.envへコピーして利用します。

# OpenAI Dashboardで作成したAPIキーを.env側だけに記入します。
OPENAI_API_KEY=

# 英会話の英文を生成するモデルと、画面の概算料金に使う単価です。
OPENAI_MODEL=gpt-5.6-luna
LLM_INPUT_USD_PER_MILLION=0.20
LLM_OUTPUT_USD_PER_MILLION=1.20
LLM_YEN_PER_USD=160

# 音声認識と音声合成に使うモデル・声・出力設定です。
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_SPEED=1.0
